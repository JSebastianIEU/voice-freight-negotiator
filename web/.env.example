# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.
# These are read ONLY on the server (route handlers). Nothing here reaches the browser.

# Same LiveKit Cloud project as agent/.env.local
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Must match AGENT_NAME in the Python worker (default: freight-negotiator)
LIVEKIT_AGENT_NAME=freight-negotiator

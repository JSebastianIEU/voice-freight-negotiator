# Copy to .env.local and fill in. .env.local is git-ignored; never commit real values.

# LiveKit Cloud project (Settings -> API keys). Inference (STT/LLM/TTS) uses the same key.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional overrides. Defaults live in src/freight_negotiator/config.py.
# STT_MODEL=deepgram/nova-3
# STT_LANGUAGE=en
# LLM_MODEL=deepseek-ai/deepseek-v3
# TTS_MODEL=cartesia/sonic-3
# TTS_VOICE=
# LOG_LEVEL=INFO
# METRICS_PATH=metrics.jsonl
